# PostgreSQL (Cranl injects DATABASE_URL when the managed database is linked)
DATABASE_URL=postgresql://user:password@host:5432/database
DATABASE_SSL=require

# Initial committee lead. Use a unique 12+ character password.
BOOTSTRAP_ADMIN_EMAIL=lead@example.com
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-long-unique-password
BOOTSTRAP_ADMIN_NAME=قائد اللجنة

# Stable 32-byte base64 key for self-hosted Next.js Server Actions.
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=replace-with-base64-key

# Required only when final email delivery is enabled.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
